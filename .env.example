# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.

# Google Gemini (utilise par src/api pour POST /ask)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.7-flash

# RAG : par defaut integre au serveur principal (python -m src.api).
# Pour un serveur RAG separe (python -m src.rag.server --port 8001), mettre son URL ici :
RAG_SERVER_URL=
RAG_EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# Optionnel : cle d'acces API HEPHAISTOS (en-tete X-API-Key)
HEPHAISTOS_API_KEY=
